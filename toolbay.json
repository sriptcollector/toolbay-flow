{
  "schema": 1,
  "id": "flow",
  "name": "Toolbay Flow",
  "tagline": "Free, local voice dictation in any app",
  "description": "Hold a key, speak, and clean formatted text appears wherever your cursor is. Speech recognition (whisper.cpp) and cleanup (llama.cpp) run on your computer. No account, no limits, no telemetry.",
  "version": "0.1.0",
  "repo": "sriptcollector/toolbay-flow",
  "identifier": "ai.toolbay.flow",
  "license": "MIT",
  "homepage": "https://github.com/sriptcollector/toolbay-flow",
  "icon": "https://raw.githubusercontent.com/sriptcollector/toolbay-flow/main/app-icon.png",
  "replaces": "Wispr Flow",
  "categories": ["productivity", "voice", "ai"],
  "platforms": {
    "windows-x86_64": {
      "asset": "Toolbay.Flow_0.1.0_x64-setup.exe",
      "kind": "nsis",
      "silentArgs": ["/S"],
      "installDir": "%LOCALAPPDATA%\\Toolbay Flow",
      "exe": "toolbay-flow.exe",
      "uninstaller": "uninstall.exe"
    },
    "darwin-aarch64": {
      "asset": "Toolbay.Flow_0.1.0_aarch64.dmg",
      "kind": "dmg",
      "app": "Toolbay Flow.app"
    },
    "darwin-x86_64": {
      "asset": "Toolbay.Flow_0.1.0_x64.dmg",
      "kind": "dmg",
      "app": "Toolbay Flow.app"
    }
  },
  "launch": {
    "args": ["--from-toolbay"],
    "singleInstance": true
  }
}
